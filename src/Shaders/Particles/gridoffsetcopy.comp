#version 430 core

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 3) readonly buffer CellOffset { uint cellOffsetBuf[]; };
layout(std430, binding = 4) buffer CellWrite { uint cellWriteBuf[]; };

uniform uint elementCount;

void main() {
	uint i = gl_GlobalInvocationID.x;
	if(i >= elementCount) return;
	cellWriteBuf[i] = cellOffsetBuf[i];
}