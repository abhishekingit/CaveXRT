#version 430 core

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 15) buffer BlockSums { uint blockSums[]; };

uniform uint blockCount;

void main() {
	uint sum = 0u;
	for(uint i = 0u; i < blockCount; i++) {
		uint c = blockSums[i];
		blockSums[i] = sum;
		sum += c;

	}
}