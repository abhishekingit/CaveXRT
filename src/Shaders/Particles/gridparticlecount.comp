#version 430 core

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

layout(std430, binding = 0) readonly buffer Particles {
	vec4 pos[];
};

layout(std430, binding = 2) buffer CellCount {
	uint countBuf[];
};

layout(std430, binding = 5) buffer ParticleCell {
	uint particleCell[];
};

uniform uint particleCount;
uniform vec3 gridMin;
uniform float cellSize;
uniform uint gridResX;
uniform uint gridResY;
uniform uint gridResZ;

uint flatten(uvec3 c) {
	return c.x + gridResX * (c.y + gridResY * c.z);
}

uint linearThreadID() {
	uvec3 wg = gl_NumWorkGroups;
	uvec3 gID = gl_WorkGroupID;
	uvec3 lID = gl_LocalInvocationID;
	uint groupLinear = gID.x + wg.x * (gID.y + wg.y * gID.z);
	uint localLinear = lID.x + 4u * (lID.y + 4u * lID.z);
	return groupLinear * 64u + localLinear;
}

void main() {
	uint idx = linearThreadID();
	if(idx >= particleCount) return;
	
	//conv world pos to grid coord
	ivec3 ci = ivec3(floor((pos[idx].xyz - gridMin) / cellSize));
	//bounds check
	ci = clamp(ci, ivec3(0), ivec3(int(gridResX - 1), int(gridResY - 1), int(gridResZ - 1)));

	//store particle's cell
	uint cell = flatten(uvec3(ci));
	particleCell[idx] = cell;

	//increment cell population
	atomicAdd(countBuf[cell], 1u);

}